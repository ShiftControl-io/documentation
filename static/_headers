# Cloudflare Pages applies these rules top-to-bottom; list the specific,
# long-lived asset paths FIRST so they win over the catch-all below.

# Hashed build assets (JS/CSS chunks) never change for a given hash — the
# filename hash changes when content changes — so cache them forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else is HTML. Because trailingSlash is enabled, pages are served
# at clean, slash-terminated URLs (e.g. /getting-started/Onboarding/) that map
# to index.html, so we can't match them by a .html suffix — the catch-all is
# the reliable way to cover them.
#
# Force HTML to always revalidate. Without this, an edge- or browser-cached
# HTML document can keep referencing chunk hashes from an older deploy that no
# longer exist on the origin, producing the 503/ERR_ABORTED errors on prefetch.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
